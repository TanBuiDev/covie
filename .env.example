SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5433/covie
DB_USERNAME=covie
DB_PASSWORD=covie_local
REDIS_URL=redis://localhost:6379
APP_PUBLIC_URL=http://localhost:3000
COVIE_AUTH_ISSUER=http://localhost:3000
COVIE_JWT_KEY_ID=covie-dev-1
COVIE_JWT_PRIVATE_KEY_PATH=infra/secrets/dev/jwt-private.pem
COVIE_JWT_PUBLIC_KEY_PATH=infra/secrets/dev/jwt-public.pem
COVIE_COOKIE_SECURE=false
# Local placeholders only. Put a real development credential in untracked .env.local.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback/google
# Optional local GPS address suggestions. Leave empty to disable; production needs a suitable provider.
COVIE_GEOCODING_REVERSE_URL=
COVIE_GEOCODING_USER_AGENT=CoVie/1.0 (https://github.com/TanBuiDev/covie)
COVIE_STORAGE_ENDPOINT=http://localhost:9000
COVIE_STORAGE_REGION=us-east-1
COVIE_STORAGE_BUCKET=covie-local
COVIE_STORAGE_FORCE_PATH_STYLE=true
COVIE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/covie-local
AWS_ACCESS_KEY_ID=covie_local
AWS_SECRET_ACCESS_KEY=covie_local_password
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_BASE_URL=http://localhost:8080
