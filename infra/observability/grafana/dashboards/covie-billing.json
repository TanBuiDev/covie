{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Retained invoices by stored status",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "covie_billing_invoices{job=\"covie-api\"}", "legendFormat": "{{instance}} {{status}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Subscriptions by stored status (not time-valid entitlement)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "covie_billing_subscriptions{job=\"covie-api\"}", "legendFormat": "{{instance}} {{status}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Merchants with a current unrevoked entitlement grant",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "refId": "A", "expr": "covie_billing_entitled_merchants{job=\"covie-api\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Pending provider-bound invoices (not confirmed transfers)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "covie_billing_reconciliation_pending{job=\"covie-api\"}", "legendFormat": "{{instance}} pending" },
        { "refId": "B", "expr": "covie_billing_reconciliation_review_required{job=\"covie-api\"}", "legendFormat": "{{instance}} discrepancy or provider failure" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Oldest pending invoice age since provider check or creation",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "covie_billing_reconciliation_oldest_check_age_seconds{job=\"covie-api\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Configuration capabilities (not provider health)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "covie_billing_reconciliation_enabled{job=\"covie-api\"}", "legendFormat": "{{instance}} reconciliation" },
        { "refId": "B", "expr": "covie_billing_payment_creation_enabled{job=\"covie-api\"}", "legendFormat": "{{instance}} payment creation" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Observed operation outcomes per second (requests, not new invoices)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "refId": "A", "expr": "sum by(operation,outcome) (rate(covie_billing_operations_seconds_count{job=\"covie-api\"}[5m]))", "legendFormat": "{{operation}} {{outcome}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Mean operation duration (not p95)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by(operation) (rate(covie_billing_operations_seconds_sum{job=\"covie-api\"}[5m])) / sum by(operation) (rate(covie_billing_operations_seconds_count{job=\"covie-api\"}[5m]))", "legendFormat": "{{operation}}" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Time since successful database snapshot (absent before first success)",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "time() - (covie_billing_database_last_success_unixtime{job=\"covie-api\"} > 0)", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Database snapshot refresh failures per second",
      "datasource": "Prometheus", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [{ "refId": "A", "expr": "rate(covie_billing_database_refresh_failures_total{job=\"covie-api\"}[5m])", "legendFormat": "{{instance}}" }]
    }
  ],
  "schemaVersion": 41,
  "tags": ["covie", "billing", "pilot"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "CoVie Billing Local Pilot",
  "uid": "covie-billing-pilot",
  "version": 1
}
